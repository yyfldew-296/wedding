<!-- 婚礼请柬 — 杨亦富 ❤ 杨静静 | 小程序版 -->

<!-- 加载屏 -->
<view class="splash" wx:if="{{!splashDone}}">
  <view class="splash-ring"></view>
  <text class="splash-xi">囍</text>
  <text class="splash-names">杨亦富 & 杨静静</text>
</view>

<!-- 音乐按钮 -->
<view class="music-btn {{musicPlaying ? 'music-spin' : ''}}" bindtap="toggleMusic">
  <text>{{musicPlaying ? '🎵' : '🔇'}}</text>
</view>

<scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="page-scroll">

  <!-- 1. 封面 -->
  <view class="section cover">
    <view class="cover-deco">
      <text class="lantern-icon">🏮</text>
      <text class="lantern-icon" style="animation-delay:0.5s">🏮</text>
    </view>
    <text class="shuangxi-big">囍</text>
    <view class="names-row">
      <text>杨亦富</text>
      <text class="heart-beat">❤</text>
      <text>杨静静</text>
    </view>
    <view class="ornament">❦</view>
    <view class="date-badge">2027年1月23日 · 腊月十六</view>
    <text class="cover-subtitle">从深圳到铜仁，从相遇到白头</text>
  </view>

  <!-- 2. 邀请语 -->
  <view class="section">
    <view class="card">
      <text class="section-title">喜 邀 您</text>
      <view class="ornament">❦</view>
      <view class="invite-text">
        <text class="invite-headline">我们要结婚啦</text>
        <text>新郎 <text class="em">杨亦富</text> · 新娘 <text class="em">杨静静</text></text>
        <text>敬邀您参加我们的婚礼</text>
        <view class="poem">
          <text>2024年秋，我们相遇</text>
          <text>2027年冬，我们成家</text>
          <text>两年多的日子里</text>
          <text>他在深圳写代码，她在家里默默成长</text>
          <text>隔着千里，每一天都在靠近彼此</text>
        </view>
        <text class="em">2027年1月23日</text>
        <text class="date-note">农历腊月十六 · 星期六</text>
        <text>贵州省铜仁市松桃苗族自治县乌罗镇</text>
        <text class="sub-note">恭候您的到来，见证我们的幸福</text>
      </view>
    </view>
  </view>

  <!-- 3. 倒计时 -->
  <view class="section">
    <view class="card">
      <text class="section-title">婚 礼 倒 计 时</text>
      <view class="ornament">❦</view>
      <text class="section-subtitle">每一天，都在靠近我们的家</text>
      <view class="countdown-grid">
        <view class="countdown-box"><text class="cd-num">{{cd.days}}</text><text class="cd-label">天</text></view>
        <view class="countdown-box"><text class="cd-num">{{cd.hours}}</text><text class="cd-label">时</text></view>
        <view class="countdown-box"><text class="cd-num">{{cd.mins}}</text><text class="cd-label">分</text></view>
        <view class="countdown-box"><text class="cd-num">{{cd.secs}}</text><text class="cd-label">秒</text></view>
      </view>
    </view>
  </view>

  <!-- 4. 照片墙 -->
  <view class="section">
    <view class="card">
      <view class="ribbon-title">💑 我们的日常</view>
      <view class="photo-wall">
        <view class="photo-frame {{index % 3 === 0 ? 'photo-tall' : ''}}" wx:for="{{photos}}" wx:key="index" bindtap="previewPhoto" data-idx="{{index}}">
          <image src="{{item.jpg}}" mode="aspectFill" class="photo-img" lazy-load />
          <view class="photo-overlay">
            <text class="photo-caption">{{item.caption}}</text>
          </view>
        </view>
      </view>
      <text class="photo-hint">📸 点击照片看大图</text>
    </view>
  </view>

  <!-- 5. 时间线 -->
  <view class="section">
    <view class="card">
      <text class="section-title">爱 的 旅 程</text>
      <view class="ornament">❦</view>
      <view class="timeline">
        <view class="tl-item" wx:for="{{timeline}}" wx:key="index">
          <view class="tl-dot {{item.heart ? 'heart-dot' : ''}}"></view>
          <view class="tl-card">
            <text class="tl-date">{{item.date}}</text>
            <text class="tl-title">{{item.title}}</text>
            <text class="tl-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 6. 誓言 -->
  <view class="section">
    <view class="card">
      <text class="section-title">我 们 的 誓 言</text>
      <view class="ornament">❦</view>
      <view class="vows-grid">
        <view class="vow-card">
          <text class="vow-label">🤵 新郎</text>
          <text class="vow-name">杨亦富</text>
          <text class="vow-text">静静，我是一个写代码的人\n不擅长说漂亮话\n但我把我们的每一天都记得很精确\n2024年10月4日 18:12，遇见你\n2024年11月25日 18:49，爱上你\n\n我在深圳加班到深夜的时候\n想到你在等我，就觉得一切都值得\n我买那辆SUV，是因为答应过你\n要开着车带你去看整个中国\n\n我没什么大本事\n但我会用一辈子，写一段只属于我们的程序\n它只有一个功能——\n让你每天都比昨天更幸福一点点</text>
        </view>
        <view class="vow-card">
          <text class="vow-label">👰 新娘</text>
          <text class="vow-name">杨静静</text>
          <text class="vow-text">亦富，谢谢你出现在我的生命里\n你总说自己不浪漫\n可你会记住我们相遇的每一分钟\n会在加班后给我打视频\n会默默存钱，计划着带我走遍全国\n\n你说你是程序员，没什么大本事\n但在我心里，你是最厉害的人\n因为你把我规划进了你的每一个未来\n\n从今天起\n你在哪，家就在哪\n不管是深圳的出租屋，还是路上的SUV\n有你的地方，就是我的家</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 7. 婚礼详情 -->
  <view class="section">
    <view class="card">
      <text class="section-title">婚 礼 信 息</text>
      <view class="ornament">❦</view>
      <view class="detail-grid">
        <view class="detail-row">
          <text class="detail-icon">📅</text>
          <text class="detail-label">婚礼日期：</text>
          <text class="detail-value">2027年1月23日（周六）· 农历腊月十六</text>
        </view>
        <view class="detail-row">
          <text class="detail-icon">⏰</text>
          <text class="detail-label">仪式时间：</text>
          <text class="detail-value">上午 10:18</text>
        </view>
        <view class="detail-row">
          <text class="detail-icon">📍</text>
          <text class="detail-label">婚礼地点：</text>
          <text class="detail-value">{{venue}}</text>
          <button class="btn-copy" bindtap="copyAddress">复制</button>
          <button class="btn-map" bindtap="openMap">🗺️ 导航</button>
        </view>
        <view class="detail-row">
          <text class="detail-icon">🍽️</text>
          <text class="detail-label">婚宴时间：</text>
          <text class="detail-value">中午 12:00</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 8. 祝福墙 -->
  <view class="section">
    <view class="card">
      <text class="section-title">祝 福 墙</text>
      <view class="ornament">❦</view>
      <text class="section-subtitle">您的每一句祝福，都是我们最珍贵的礼物</text>
      <view class="blessing-form">
        <input placeholder="您的名字" value="{{blessName}}" bindinput="onNameInput" maxlength="20" />
        <textarea placeholder="想对我们说的话……" value="{{blessMsg}}" bindinput="onMsgInput" maxlength="200" />
        <button class="btn-submit" bindtap="submitBlessing">💝 送 出 祝 福</button>
      </view>
      <view class="blessing-list">
        <view class="blessing-item" wx:for="{{blessings}}" wx:key="index">
          <text class="b-name">{{item.name}}</text>
          <text class="b-msg">{{item.msg}}</text>
          <text class="b-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="end-xi">囍</text>
    <text class="names-sm">杨亦富 ❤ 杨静静</text>
    <text class="motto">2024.10.04 相遇 · 2024.11.25 相爱 · 2027.01.23 成家</text>
    <text class="motto motto-sm">两个人 · 一辈子</text>
  </view>

</scroll-view>
