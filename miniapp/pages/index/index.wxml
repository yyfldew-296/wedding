<!-- 婚礼请柬 -->

<!-- 加载屏 -->
<view class="splash" wx:if="{{!splashDone}}">
  <view class="splash-ring"></view>
  <text class="splash-xi">囍</text>
  <text class="splash-names">杨亦富 & 杨静静</text>
</view>

<!-- 爱心Canvas -->
<canvas type="2d" id="heartCanvas" class="heart-canvas"></canvas>

<!-- 音乐按钮 -->
<view class="music-btn {{musicPlaying ? 'music-spin' : ''}}" bindtap="toggleMusic">
  <text>{{musicPlaying ? '🎵' : '🔇'}}</text>
</view>

<!-- 滚动进度条 -->
<view class="progress-bar">
  <view class="progress-fill" style="width:{{scrollPercent}}%"></view>
</view>

<view class="main-wrap">

  <!-- 1. 封面 -->
  <view class="scene cover-scene">
    <view class="cover-deco">
      <text class="lantern-icon">🏮</text>
      <text class="lantern-icon">🏮</text>
    </view>
    <text class="shuangxi-big">囍</text>
    <view class="names-row">杨亦富<text class="heart-beat">❤</text>杨静静</view>
    <view class="date-badge">2027.01.23 · 腊月十六</view>
    <text class="cover-subtitle">从深圳到铜仁，从相遇到白头</text>
    <text class="scroll-hint">向上滑动 开启我们的故事</text>
  </view>

  <!-- 分隔线 -->
  <view class="divider"><text>❦</text></view>

  <!-- 2. 邀请语 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">喜 邀 您</text>
      <view class="ornament">❦</view>
      <view class="invite-text">
        <text class="invite-headline">我们要结婚啦</text>
        <text>新郎 <text class="em">杨亦富</text> · 新娘 <text class="em">杨静静</text></text>
        <text>敬邀您参加我们的婚礼</text>
        <view class="poem">
          <text>2024年秋，我们相遇</text>
          <text>2027年冬，我们成家</text>
          <text>他在深圳写代码</text>
          <text>她在家里默默成长</text>
          <text>隔着千里，每一天都在靠近彼此</text>
        </view>
        <text class="date-big">2027年1月23日</text>
        <text class="date-note">农历腊月十六 · 星期六</text>
        <text>贵州省铜仁市松桃苗族自治县乌罗镇</text>
        <text class="sub-note">恭候您的到来，见证我们的幸福</text>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 3. 倒计时 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">婚 礼 倒 计 时</text>
      <view class="ornament">❦</view>
      <text class="sec-subtitle">每一天，都在靠近我们的家</text>
      <view class="countdown-grid">
        <view class="cd-box"><text class="cd-num">{{cd.days}}</text><text class="cd-label">天</text></view>
        <view class="cd-box"><text class="cd-num">{{cd.hours}}</text><text class="cd-label">时</text></view>
        <view class="cd-box"><text class="cd-num">{{cd.mins}}</text><text class="cd-label">分</text></view>
        <view class="cd-box"><text class="cd-num">{{cd.secs}}</text><text class="cd-label">秒</text></view>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 4. 照片 · 长图全宽 -->
  <view class="scene">
    <text class="sec-title">💑 我们的日常</text>
    <view class="ornament">❦</view>
    <view class="photo-list">
      <view class="photo-full" wx:for="{{photos}}" wx:key="index" bindtap="previewPhoto" data-idx="{{index}}">
        <image src="{{item.jpg}}" mode="widthFix" class="photo-full-img" lazy-load />
        <view class="photo-full-cap">
          <text class="photo-full-cap-text">{{item.caption}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 5. 时间线 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">爱 的 旅 程</text>
      <view class="ornament">❦</view>
      <view class="timeline">
        <view class="tl-item" wx:for="{{timeline}}" wx:key="index">
          <view class="tl-dot {{item.heart ? 'heart-dot' : ''}}">
            <text wx:if="{{item.heart}}" class="tl-dot-heart">❤</text>
          </view>
          <view class="tl-card">
            <text class="tl-date">{{item.date}}</text>
            <text class="tl-title">{{item.title}}</text>
            <text class="tl-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 6. 誓言 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">我 们 的 誓 言</text>
      <view class="ornament">❦</view>
      <view class="vows-grid">
        <view class="vow-card">
          <text class="vow-label">🤵 新郎</text>
          <text class="vow-name">杨亦富</text>
          <text class="vow-text">{{groomVow}}</text>
        </view>
        <view class="vow-card">
          <text class="vow-label">👰 新娘</text>
          <text class="vow-name">杨静静</text>
          <text class="vow-text">{{brideVow}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 7. 婚礼详情 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">婚 礼 信 息</text>
      <view class="ornament">❦</view>
      <view class="detail-list">
        <view class="d-row"><text class="d-icon">📅</text><text class="d-label">日期</text><text class="d-val">2027年1月23日（周六）· 腊月十六</text></view>
        <view class="d-row"><text class="d-icon">⏰</text><text class="d-label">仪式</text><text class="d-val">上午 10:18</text></view>
        <view class="d-row"><text class="d-icon">📍</text><text class="d-label">地点</text><text class="d-val">{{venue}}</text></view>
        <view class="d-row"><text class="d-icon">🍽️</text><text class="d-label">婚宴</text><text class="d-val">中午 12:00</text></view>
      </view>
      <view class="detail-btns">
        <button class="btn-copy" bindtap="copyAddress">📋 复制地址</button>
        <button class="btn-map" bindtap="openMap">🗺️ 一键导航</button>
      </view>
    </view>
  </view>

  <view class="divider"><text>❦</text></view>

  <!-- 8. 祝福墙 -->
  <view class="scene">
    <view class="glass-card">
      <text class="sec-title">祝 福 墙</text>
      <view class="ornament">❦</view>
      <text class="sec-subtitle">您的每一句祝福，都是我们最珍贵的礼物</text>
      <view class="blessing-form">
        <input placeholder="您的名字" value="{{blessName}}" bindinput="onNameInput" maxlength="20" />
        <textarea placeholder="想对我们说的话……" value="{{blessMsg}}" bindinput="onMsgInput" maxlength="200" />
        <button class="btn-submit" bindtap="submitBlessing">💝 送 出 祝 福</button>
      </view>
      <view class="blessing-list">
        <view class="blessing-item" wx:for="{{blessings}}" wx:key="index">
          <text class="b-name">🧧 {{item.name}}</text>
          <text class="b-msg">{{item.msg}}</text>
          <text class="b-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="end-xi">囍</text>
    <text class="names-sm">杨亦富 ❤ 杨静静</text>
    <text class="motto">2024.10.04 相遇 · 2024.11.25 相爱 · 2027.01.23 成家</text>
    <text class="motto motto-sm">两个人 · 一辈子</text>
  </view>

</view>
