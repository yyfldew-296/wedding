/* ==========================================
   婚礼请柬 · 长图全宽版
   ========================================== */

/* === 页面 === */
page { background: linear-gradient(180deg, #f8e0d4 0%, #EFC8B2 20%, #e8c8b0 50%, #f0d8c4 80%, #EFC8B2 100%); color: #4a2c20; }

/* === 加载屏 === */
.splash { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #f8e0d4; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.splash-ring { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid #c47a5a; animation: splashPulse 1.2s ease-in-out infinite; }
@keyframes splashPulse { 0%,100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(1.3); opacity: 1; } }
.splash-xi { font-size: 80rpx; color: #a85a3a; margin-top: 30rpx; font-weight: bold; }
.splash-names { font-size: 28rpx; color: #6b3a2a; letter-spacing: 8rpx; margin-top: 16rpx; }

/* === 爱心Canvas === */
.heart-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

/* === 音乐 === */
.music-btn { position: fixed; top: 30rpx; right: 30rpx; z-index: 100; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.75); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1); font-size: 36rpx; }
.music-spin { animation: musicRotate 3s linear infinite; }
@keyframes musicRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* === 进度条 === */
.progress-bar { position: fixed; top: 0; left: 0; width: 100%; height: 4rpx; z-index: 101; background: transparent; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #c47a5a, #d47060); transition: width 0.3s ease; }

/* === 主容器 === */
.main-wrap { position: relative; z-index: 2; padding-bottom: 60rpx; }

/* === 场景 === */
.scene { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 80rpx 36rpx; box-sizing: border-box; }

/* === 分隔线 === */
.divider { text-align: center; padding: 20rpx 0; color: #c47a5a; font-size: 24rpx; opacity: 0.4; }

/* === 毛玻璃卡片 === */
.glass-card { background: rgba(255,245,238,0.6); border: 2rpx solid rgba(255,255,255,0.5); border-radius: 40rpx; padding: 70rpx 45rpx; width: 100%; max-width: 640rpx; box-shadow: 0 20rpx 60rpx rgba(168,90,58,0.08), 0 0 0 1rpx rgba(255,255,255,0.2) inset; }

/* === 标题 === */
.sec-title { font-size: 42rpx; color: #a85a3a; letter-spacing: 18rpx; margin-bottom: 28rpx; display: block; font-weight: bold; }
.sec-subtitle { font-size: 28rpx; color: #6b3a2a; letter-spacing: 6rpx; margin-bottom: 36rpx; display: block; }
.ornament { color: #c47a5a; font-size: 28rpx; margin: 18rpx 0; display: flex; align-items: center; justify-content: center; }

/* === 封面 === */
.cover-scene { position: relative; }
.cover-deco { display: flex; justify-content: center; margin-bottom: 20rpx; }
.lantern-icon { font-size: 68rpx; margin: 0 20rpx; animation: lanternBounce 2s ease-in-out infinite; }
@keyframes lanternBounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-18rpx); } }
.shuangxi-big { font-size: 170rpx; font-weight: bold; background: linear-gradient(180deg, #c9963a, #a85a3a); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1; }
.names-row { font-size: 50rpx; color: #4a2c20; letter-spacing: 20rpx; margin: 32rpx 0; }
.heart-beat { color: #d46050; margin: 0 10rpx; animation: heartPop 1s ease-in-out infinite; }
@keyframes heartPop { 0%,100% { transform: scale(1); } 30% { transform: scale(1.3); } 50% { transform: scale(1); } 70% { transform: scale(1.15); } }
.date-badge { display: inline-block; background: #a85a3a; border: 2rpx solid #c9963a; border-radius: 50rpx; padding: 20rpx 60rpx; font-size: 34rpx; letter-spacing: 10rpx; color: #faf0c8; margin-top: 24rpx; }
.cover-subtitle { font-size: 28rpx; color: #6b3a2a; letter-spacing: 6rpx; margin-top: 32rpx; display: block; }
.scroll-hint { font-size: 24rpx; color: #c47a5a; letter-spacing: 4rpx; margin-top: 80rpx; opacity: 0.5; animation: hintPulse 2s ease-in-out infinite; display: block; }
@keyframes hintPulse { 0%,100% { opacity: 0.2; } 50% { opacity: 0.7; } }

/* === 邀请语 === */
.invite-text { line-height: 2.8; letter-spacing: 4rpx; display: flex; flex-direction: column; align-items: center; font-size: 30rpx; }
.invite-headline { font-size: 40rpx; color: #a85a3a; letter-spacing: 12rpx; font-weight: bold; margin-bottom: 24rpx; }
.em { color: #a85a3a; font-weight: bold; }
.date-big { font-size: 38rpx; color: #a85a3a; font-weight: bold; letter-spacing: 8rpx; margin-top: 24rpx; }
.date-note { font-size: 26rpx; color: #6b3a2a; margin-bottom: 14rpx; }
.sub-note { font-size: 28rpx; margin-top: 28rpx; }
.poem { color: #6b3a2a; font-style: italic; margin: 28rpx 0; line-height: 2.6; display: flex; flex-direction: column; }

/* === 倒计时 === */
.countdown-grid { display: flex; justify-content: center; flex-wrap: wrap; margin-top: 16rpx; }
.cd-box { margin: 14rpx; background: #a85a3a; border: 2rpx solid #c9963a; border-radius: 30rpx; padding: 40rpx 44rpx; min-width: 150rpx; box-shadow: 0 20rpx 50rpx rgba(168,90,58,0.3); animation: cdIn 0.5s ease backwards; }
.cd-box:nth-child(1) { animation-delay: 0.1s; } .cd-box:nth-child(2) { animation-delay: 0.2s; } .cd-box:nth-child(3) { animation-delay: 0.3s; } .cd-box:nth-child(4) { animation-delay: 0.4s; }
@keyframes cdIn { from { opacity: 0; transform: translateY(50rpx) scale(0.8); } }
.cd-num { font-size: 70rpx; font-weight: bold; color: #faf0c8; display: block; }
.cd-label { font-size: 28rpx; color: #c9963a; letter-spacing: 8rpx; margin-top: 12rpx; }

/* === 照片 · 长图全宽 === */
.photo-list { width: 100%; max-width: 640rpx; }
.photo-full { position: relative; margin-bottom: 32rpx; border-radius: 20rpx; overflow: hidden; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12); }
.photo-full-img { width: 100%; display: block; }
.photo-full-cap { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.45)); padding: 50rpx 24rpx 20rpx; }
.photo-full-cap-text { color: #fff; font-size: 28rpx; letter-spacing: 4rpx; }

/* === 时间线 === */
.timeline { position: relative; padding: 36rpx 0; }
.timeline::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 3rpx; background: linear-gradient(180deg, transparent, #c47a5a 20%, #c47a5a 80%, transparent); transform: translateX(-50%); }
.tl-item { display: flex; margin: 32rpx 0; position: relative; }
.tl-item:nth-child(odd) { flex-direction: row; } .tl-item:nth-child(even) { flex-direction: row-reverse; }
.tl-dot { position: absolute; left: 50%; top: 24rpx; width: 28rpx; height: 28rpx; background: #c9963a; border-radius: 50%; transform: translateX(-50%); z-index: 2; display: flex; align-items: center; justify-content: center; }
.tl-dot.heart-dot { width: 40rpx; height: 40rpx; background: #d46050; box-shadow: 0 0 24rpx rgba(200,100,80,0.5); }
.tl-dot-heart { font-size: 22rpx; color: #fff; animation: heartPop 2s ease-in-out infinite; }
.tl-card { width: calc(50% - 60rpx); background: rgba(255,255,255,0.65); border: 2rpx solid rgba(255,255,255,0.7); border-radius: 22rpx; padding: 28rpx 30rpx; text-align: left; }
.tl-date { font-size: 24rpx; color: #c47a5a; letter-spacing: 4rpx; }
.tl-title { font-size: 32rpx; color: #a85a3a; letter-spacing: 4rpx; margin: 10rpx 0; display: block; }
.tl-desc { font-size: 28rpx; color: #4a2c20; line-height: 1.9; }

/* === 誓言 === */
.vows-grid { display: flex; gap: 20rpx; }
.vow-card { flex: 1; background: rgba(255,255,255,0.55); border: 2rpx solid rgba(255,255,255,0.6); border-radius: 28rpx; padding: 44rpx 30rpx; text-align: center; }
.vow-label { font-size: 28rpx; color: #c47a5a; letter-spacing: 12rpx; }
.vow-name { font-size: 40rpx; color: #a85a3a; letter-spacing: 12rpx; margin: 20rpx 0; display: block; }
.vow-text { font-size: 28rpx; color: #4a2c20; line-height: 2.1; font-style: italic; white-space: pre-line; }

/* === 详情 === */
.detail-list { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 40rpx; }
.d-row { display: flex; align-items: center; padding: 12rpx 0; }
.d-icon { font-size: 44rpx; margin-right: 20rpx; }
.d-label { font-size: 30rpx; color: #c47a5a; font-weight: bold; letter-spacing: 6rpx; width: 90rpx; text-align: left; }
.d-val { font-size: 30rpx; color: #4a2c20; flex: 1; text-align: left; }
.detail-btns { display: flex; justify-content: center; gap: 28rpx; margin-top: 16rpx; }
.btn-copy, .btn-map { padding: 20rpx 44rpx; border-radius: 48rpx; font-size: 30rpx; letter-spacing: 6rpx; }
.btn-copy { background: #a85a3a; color: #faf0c8; }
.btn-map { background: rgba(255,255,255,0.6); color: #a85a3a; border: 2rpx solid #a85a3a; }
button.btn-copy::after, button.btn-map::after { border: none; }

/* === 祝福墙 === */
.blessing-form { display: flex; flex-direction: column; }
.blessing-form input, .blessing-form textarea { width: 100%; padding: 26rpx; margin-bottom: 20rpx; border: 2rpx solid rgba(255,255,255,0.7); border-radius: 22rpx; font-size: 30rpx; background: rgba(255,255,255,0.45); color: #4a2c20; }
.blessing-form textarea { height: 150rpx; }
.btn-submit { padding: 26rpx 60rpx; background: #a85a3a; color: #faf0c8; border: 2rpx solid #c9963a; border-radius: 60rpx; font-size: 32rpx; letter-spacing: 10rpx; }
button.btn-submit::after { border: none; }
.blessing-list { margin-top: 40rpx; }
.blessing-item { background: rgba(255,255,255,0.55); border: 2rpx solid rgba(255,255,255,0.6); border-radius: 22rpx; padding: 26rpx 30rpx; margin: 18rpx 0; text-align: left; }
.b-name { font-size: 30rpx; color: #a85a3a; font-weight: bold; letter-spacing: 4rpx; }
.b-msg { font-size: 30rpx; color: #4a2c20; line-height: 1.9; display: block; margin-top: 10rpx; }
.b-time { font-size: 24rpx; color: #c47a5a; text-align: right; margin-top: 12rpx; display: block; }

/* === 底部 === */
.footer { text-align: center; padding: 120rpx 30rpx 60rpx; }
.end-xi { font-size: 100rpx; color: #b87040; }
.names-sm { font-size: 34rpx; color: #4a2c20; letter-spacing: 14rpx; display: block; margin-top: 36rpx; }
.motto { font-size: 26rpx; color: #6b3a2a; display: block; margin-top: 18rpx; }
.motto-sm { margin-top: 10rpx; opacity: 0.5; }
