/* ==========================================
   婚礼请柬 · Glassmorphism 专业版
   ========================================== */

/* === 页面 === */
page { background: linear-gradient(180deg, #f8e0d4 0%, #EFC8B2 30%, #e8c8b0 70%, #f0d8c4 100%); color: #4a2c20; }

/* === 加载屏 === */
.splash { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #f8e0d4; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.splash-ring { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid #c47a5a; animation: splashPulse 1.2s ease-in-out infinite; }
@keyframes splashPulse { 0%,100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(1.3); opacity: 1; } }
.splash-xi { font-size: 80rpx; color: #a85a3a; margin-top: 30rpx; font-weight: bold; }
.splash-names { font-size: 28rpx; color: #6b3a2a; letter-spacing: 8rpx; margin-top: 16rpx; }

/* === 爱心Canvas === */
.heart-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

/* === 音乐 === */
.music-btn { position: fixed; top: 30rpx; right: 30rpx; z-index: 100; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.75); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1); font-size: 36rpx; }
.music-spin { animation: musicRotate 3s linear infinite; }
@keyframes musicRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* === 主容器 === */
.main-wrap { position: relative; z-index: 2; padding-bottom: 40rpx; }

/* === 场景 === */
.scene { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 80rpx 40rpx; box-sizing: border-box; }

/* === 毛玻璃卡片 === */
.glass-card { background: rgba(255,245,238,0.65); backdrop-filter: blur(20px); border: 2rpx solid rgba(255,255,255,0.6); border-radius: 40rpx; padding: 70rpx 50rpx; width: 100%; max-width: 640rpx; box-shadow: 0 20rpx 60rpx rgba(168,90,58,0.1), 0 0 0 1rpx rgba(255,255,255,0.3) inset; }

/* === 标题 === */
.sec-title { font-size: 40rpx; color: #a85a3a; letter-spacing: 16rpx; margin-bottom: 28rpx; display: block; font-weight: bold; }
.sec-subtitle { font-size: 28rpx; color: #6b3a2a; letter-spacing: 6rpx; margin-bottom: 36rpx; display: block; }
.ornament { color: #c47a5a; font-size: 28rpx; margin: 18rpx 0; display: flex; align-items: center; justify-content: center; }

/* === 封面 === */
.cover-scene { position: relative; }
.cover-deco { display: flex; justify-content: center; margin-bottom: 16rpx; }
.lantern-icon { font-size: 64rpx; margin: 0 16rpx; animation: lanternBounce 2s ease-in-out infinite; }
@keyframes lanternBounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
.shuangxi-big { font-size: 160rpx; font-weight: bold; color: #b88030; line-height: 1; }
.names-row { font-size: 48rpx; color: #4a2c20; letter-spacing: 16rpx; margin: 30rpx 0; }
.heart-beat { color: #d46050; margin: 0 8rpx; animation: heartPop 1s ease-in-out infinite; }
@keyframes heartPop { 0%,100% { transform: scale(1); } 30% { transform: scale(1.3); } 50% { transform: scale(1); } 70% { transform: scale(1.15); } }
.date-badge { display: inline-block; background: #a85a3a; border: 2rpx solid #c9963a; border-radius: 50rpx; padding: 18rpx 56rpx; font-size: 32rpx; letter-spacing: 8rpx; color: #faf0c8; margin-top: 20rpx; }
.cover-subtitle { font-size: 28rpx; color: #6b3a2a; letter-spacing: 6rpx; margin-top: 28rpx; display: block; }
.scroll-hint { font-size: 24rpx; color: #c47a5a; letter-spacing: 4rpx; margin-top: 60rpx; opacity: 0.5; animation: hintPulse 2s ease-in-out infinite; display: block; }
@keyframes hintPulse { 0%,100% { opacity: 0.2; } 50% { opacity: 0.7; } }

/* === 邀请语 === */
.invite-text { line-height: 2.6; letter-spacing: 4rpx; display: flex; flex-direction: column; align-items: center; font-size: 30rpx; }
.invite-headline { font-size: 38rpx; color: #a85a3a; letter-spacing: 10rpx; font-weight: bold; margin-bottom: 20rpx; }
.em { color: #a85a3a; font-weight: bold; }
.date-big { font-size: 36rpx; color: #a85a3a; font-weight: bold; letter-spacing: 6rpx; margin-top: 20rpx; }
.date-note { font-size: 26rpx; color: #6b3a2a; margin-bottom: 12rpx; }
.sub-note { font-size: 28rpx; margin-top: 24rpx; }
.poem { color: #6b3a2a; font-style: italic; margin: 24rpx 0; line-height: 2.4; display: flex; flex-direction: column; }

/* === 倒计时 === */
.countdown-grid { display: flex; justify-content: center; flex-wrap: wrap; margin-top: 10rpx; }
.cd-box { margin: 12rpx; background: #a85a3a; border: 2rpx solid #c9963a; border-radius: 28rpx; padding: 36rpx 40rpx; min-width: 140rpx; box-shadow: 0 16rpx 40rpx rgba(168,90,58,0.3); animation: cdIn 0.5s ease backwards; }
.cd-box:nth-child(1) { animation-delay: 0.1s; } .cd-box:nth-child(2) { animation-delay: 0.2s; } .cd-box:nth-child(3) { animation-delay: 0.3s; } .cd-box:nth-child(4) { animation-delay: 0.4s; }
@keyframes cdIn { from { opacity: 0; transform: translateY(40rpx) scale(0.85); } }
.cd-num { font-size: 64rpx; font-weight: bold; color: #faf0c8; display: block; }
.cd-label { font-size: 26rpx; color: #c9963a; letter-spacing: 6rpx; margin-top: 10rpx; }

/* === 照片轮播 === */
.photo-swiper { width: 100%; max-width: 640rpx; height: 700rpx; border-radius: 24rpx; overflow: hidden; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15); }
.swiper-photo { width: 100%; height: 100%; }
.swiper-caption { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.5)); padding: 60rpx 30rpx 30rpx; }
.swiper-cap-text { color: #fff; font-size: 30rpx; letter-spacing: 4rpx; }

/* === 时间线 === */
.timeline { position: relative; padding: 30rpx 0; }
.timeline::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 3rpx; background: #c47a5a; transform: translateX(-50%); }
.tl-item { display: flex; margin: 28rpx 0; position: relative; }
.tl-item:nth-child(odd) { flex-direction: row; } .tl-item:nth-child(even) { flex-direction: row-reverse; }
.tl-dot { position: absolute; left: 50%; top: 22rpx; width: 24rpx; height: 24rpx; background: #c9963a; border-radius: 50%; transform: translateX(-50%); z-index: 2; display: flex; align-items: center; justify-content: center; }
.tl-dot.heart-dot { width: 36rpx; height: 36rpx; background: #d46050; box-shadow: 0 0 20rpx rgba(200,100,80,0.5); }
.tl-dot-heart { font-size: 20rpx; color: #fff; animation: heartPop 2s ease-in-out infinite; }
.tl-card { width: calc(50% - 56rpx); background: rgba(255,255,255,0.7); border: 2rpx solid rgba(255,255,255,0.8); border-radius: 20rpx; padding: 24rpx 28rpx; text-align: left; backdrop-filter: blur(10px); }
.tl-date { font-size: 22rpx; color: #c47a5a; letter-spacing: 3rpx; }
.tl-title { font-size: 30rpx; color: #a85a3a; letter-spacing: 4rpx; margin: 8rpx 0; display: block; }
.tl-desc { font-size: 26rpx; color: #4a2c20; line-height: 1.8; }

/* === 誓言 === */
.vows-grid { display: flex; }
.vow-card { flex: 1; margin: 0 14rpx; background: rgba(255,255,255,0.6); border: 2rpx solid rgba(255,255,255,0.7); border-radius: 24rpx; padding: 40rpx 32rpx; text-align: center; backdrop-filter: blur(10px); }
.vow-label { font-size: 26rpx; color: #c47a5a; letter-spacing: 10rpx; }
.vow-name { font-size: 36rpx; color: #a85a3a; letter-spacing: 10rpx; margin: 18rpx 0; display: block; }
.vow-text { font-size: 26rpx; color: #4a2c20; line-height: 2; font-style: italic; white-space: pre-line; }

/* === 详情 === */
.detail-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 36rpx; }
.d-row { display: flex; align-items: center; padding: 10rpx 0; }
.d-icon { font-size: 40rpx; margin-right: 16rpx; }
.d-label { font-size: 28rpx; color: #c47a5a; font-weight: bold; letter-spacing: 4rpx; width: 80rpx; text-align: left; }
.d-val { font-size: 28rpx; color: #4a2c20; flex: 1; text-align: left; }
.detail-btns { display: flex; justify-content: center; gap: 24rpx; }
.btn-copy, .btn-map { padding: 18rpx 40rpx; border-radius: 44rpx; font-size: 28rpx; letter-spacing: 4rpx; }
.btn-copy { background: #a85a3a; color: #faf0c8; }
.btn-map { background: rgba(255,255,255,0.7); color: #a85a3a; border: 2rpx solid #a85a3a; }
button.btn-copy::after, button.btn-map::after { border: none; }

/* === 祝福墙 === */
.blessing-form { display: flex; flex-direction: column; }
.blessing-form input, .blessing-form textarea { width: 100%; padding: 24rpx; margin-bottom: 18rpx; border: 2rpx solid rgba(255,255,255,0.8); border-radius: 20rpx; font-size: 28rpx; background: rgba(255,255,255,0.5); color: #4a2c20; }
.blessing-form textarea { height: 140rpx; }
.btn-submit { padding: 24rpx 60rpx; background: #a85a3a; color: #faf0c8; border: 2rpx solid #c9963a; border-radius: 60rpx; font-size: 30rpx; letter-spacing: 8rpx; }
button.btn-submit::after { border: none; }
.blessing-list { margin-top: 36rpx; }
.blessing-item { background: rgba(255,255,255,0.6); border: 2rpx solid rgba(255,255,255,0.7); border-radius: 20rpx; padding: 24rpx 28rpx; margin: 16rpx 0; text-align: left; backdrop-filter: blur(10px); }
.b-name { font-size: 28rpx; color: #a85a3a; font-weight: bold; letter-spacing: 4rpx; }
.b-msg { font-size: 28rpx; color: #4a2c20; line-height: 1.8; display: block; margin-top: 8rpx; }
.b-time { font-size: 22rpx; color: #c47a5a; text-align: right; margin-top: 10rpx; display: block; }

/* === 底部 === */
.footer { text-align: center; padding: 100rpx 30rpx; }
.end-xi { font-size: 90rpx; color: #b87040; }
.names-sm { font-size: 32rpx; color: #4a2c20; letter-spacing: 12rpx; display: block; margin-top: 30rpx; }
.motto { font-size: 24rpx; color: #6b3a2a; display: block; margin-top: 16rpx; }
.motto-sm { margin-top: 8rpx; opacity: 0.6; }
